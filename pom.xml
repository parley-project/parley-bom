        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-files-sftp-parley-ssh</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-files-jdbc</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-files-swing</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-files-fx</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-credentials-keychain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner</groupId>
        <artifactId>bringardner-swing-widgets</artifactId>
        <version>${bringardner-swing-widgets.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner</groupId>
        <artifactId>bringardner-fx-widgets</artifactId>
        <version>${bringardner-fx-widgets.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
