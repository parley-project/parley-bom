<?xml version="1.0" encoding="UTF-8"?>
<!--
  Parley bill of materials.

  Users import this once and then add Parley modules without versions:

    <dependencyManagement>
      <dependencies>
        <dependency>
          <groupId>us.bringardner.parley</groupId>
          <artifactId>parley-bom</artifactId>
          <version>1.0.0</version>
          <type>pom</type>
          <scope>import</scope>
        </dependency>
      </dependencies>
    </dependencyManagement>

    <dependency>
      <groupId>us.bringardner.parley</groupId>
      <artifactId>parley-dns</artifactId>
    </dependency>

  Each BOM release is a tested-together set. Release a new BOM whenever any module
  version below changes. Lists ONLY the author's own artifacts (Parley modules and the widget libraries) - never third-party ones,
  and never applications built on Parley (parley-files-viewer, fsh, fsh-ide), which nothing depends on.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>us.bringardner.parley</groupId>
    <artifactId>parley-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <!-- Sibling folder locally; resolved from Central once the parent is published -->
    <relativePath>../parley-parent/pom.xml</relativePath>
  </parent>

  <artifactId>parley-bom</artifactId>
  <packaging>pom</packaging>

  <name>${project.groupId}:${project.artifactId}</name>
  <description>Parley bill of materials: compatible versions of every Parley module.</description>

  <properties>
    <!-- Parley modules are versioned in lockstep: every managed parley-* version is ${project.version}. -->
    <!-- Widget libraries, published under us.bringardner (not us.bringardner.parley) -->
    <bringardner-swing-widgets.version>1.0.0</bringardner-swing-widgets.version>
    <bringardner-fx-widgets.version>1.0.0</bringardner-fx-widgets.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-brand</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-io</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-term</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-net</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-ftp</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-dns</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-ssh</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-mail</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-smtp</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-imap</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-pop3</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-dap</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-loupe</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-files</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-files-ftp</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-files-sftp</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-files-sftp-jsch</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
