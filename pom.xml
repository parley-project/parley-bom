<?xml version="1.0" encoding="UTF-8"?>
<!--
  Parley bill of materials.

  Users import this once and then add Parley modules without versions:

    <dependencyManagement>
      <dependencies>
        <dependency>
          <groupId>us.bringardner.parley</groupId>
          <artifactId>parley-bom</artifactId>
          <version>1.0.0</version>
          <type>pom</type>
          <scope>import</scope>
        </dependency>
      </dependencies>
    </dependencyManagement>

    <dependency>
      <groupId>us.bringardner.parley</groupId>
      <artifactId>parley-dns</artifactId>
    </dependency>

  Each BOM release is a tested-together set. Release a new BOM whenever any module
  version below changes. Lists ONLY the author's own artifacts (Parley modules and the widget libraries) - never third-party ones,
  and never applications built on Parley (parley-files-viewer, fsh, fsh-ide), which nothing depends on.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>us.bringardner.parley</groupId>
    <artifactId>parley-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <!-- Sibling folder locally; resolved from Central once the parent is published -->
    <relativePath>../parley-parent/pom.xml</relativePath>
  </parent>

  <artifactId>parley-bom</artifactId>
  <version>2.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>${project.groupId}:${project.artifactId}</name>
  <description>Parley bill of materials: compatible versions of every Parley module.</description>

  <properties>
    <!-- One line per module. Keep these in step with each module's released version. -->
    <parley-core.version>2.0.0-SNAPSHOT</parley-core.version>
    <parley-brand.version>2.0.0-SNAPSHOT</parley-brand.version>
    <parley-io.version>2.0.0-SNAPSHOT</parley-io.version>
    <parley-net.version>2.0.0-SNAPSHOT</parley-net.version>
    <parley-ftp.version>2.0.0-SNAPSHOT</parley-ftp.version>
    <parley-dns.version>2.0.0-SNAPSHOT</parley-dns.version>
    <parley-ssh.version>2.0.0-SNAPSHOT</parley-ssh.version>
    <parley-mail.version>2.0.0-SNAPSHOT</parley-mail.version>
    <parley-smtp.version>2.0.0-SNAPSHOT</parley-smtp.version>
    <parley-imap.version>2.0.0-SNAPSHOT</parley-imap.version>
    <parley-pop3.version>2.0.0-SNAPSHOT</parley-pop3.version>
    <parley-dap.version>2.0.0-SNAPSHOT</parley-dap.version>
    <parley-loupe.version>2.0.0-SNAPSHOT</parley-loupe.version>
    <parley-files.version>2.0.0-SNAPSHOT</parley-files.version>
    <parley-files-ftp.version>2.0.0-SNAPSHOT</parley-files-ftp.version>
    <parley-files-sftp.version>2.0.0-SNAPSHOT</parley-files-sftp.version>
    <parley-files-sftp-jsch.version>2.0.0-SNAPSHOT</parley-files-sftp-jsch.version>
    <parley-files-sftp-mina.version>2.0.0-SNAPSHOT</parley-files-sftp-mina.version>
    <parley-files-sftp-parley-ssh.version>2.0.0-SNAPSHOT</parley-files-sftp-parley-ssh.version>
    <parley-files-jdbc.version>2.0.0-SNAPSHOT</parley-files-jdbc.version>
    <parley-files-swing.version>2.0.0-SNAPSHOT</parley-files-swing.version>
    <parley-files-fx.version>2.0.0-SNAPSHOT</parley-files-fx.version>
    <parley-credentials-keychain.version>2.0.0-SNAPSHOT</parley-credentials-keychain.version>
    <!-- Widget libraries, published under us.bringardner (not us.bringardner.parley) -->
    <bringardner-swing-widgets.version>1.0.0</bringardner-swing-widgets.version>
    <bringardner-fx-widgets.version>1.0.0</bringardner-fx-widgets.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-core</artifactId>
        <version>${parley-core.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-brand</artifactId>
        <version>${parley-brand.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-io</artifactId>
        <version>${parley-io.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-net</artifactId>
        <version>${parley-net.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-ftp</artifactId>
        <version>${parley-ftp.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-dns</artifactId>
        <version>${parley-dns.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-ssh</artifactId>
        <version>${parley-ssh.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-mail</artifactId>
        <version>${parley-mail.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-smtp</artifactId>
        <version>${parley-smtp.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-imap</artifactId>
        <version>${parley-imap.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-pop3</artifactId>
        <version>${parley-pop3.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-dap</artifactId>
        <version>${parley-dap.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-loupe</artifactId>
        <version>${parley-loupe.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-files</artifactId>
        <version>${parley-files.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-files-ftp</artifactId>
        <version>${parley-files-ftp.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-files-sftp</artifactId>
        <version>${parley-files-sftp.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-files-sftp-jsch</artifactId>
        <version>${parley-files-sftp-jsch.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-files-sftp-mina</artifactId>
        <version>${parley-files-sftp-mina.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-files-sftp-parley-ssh</artifactId>
        <version>${parley-files-sftp-parley-ssh.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-files-jdbc</artifactId>
        <version>${parley-files-jdbc.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-files-swing</artifactId>
        <version>${parley-files-swing.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-files-fx</artifactId>
        <version>${parley-files-fx.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner.parley</groupId>
        <artifactId>parley-credentials-keychain</artifactId>
        <version>${parley-credentials-keychain.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner</groupId>
        <artifactId>bringardner-swing-widgets</artifactId>
        <version>${bringardner-swing-widgets.version}</version>
      </dependency>
      <dependency>
        <groupId>us.bringardner</groupId>
        <artifactId>bringardner-fx-widgets</artifactId>
        <version>${bringardner-fx-widgets.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
